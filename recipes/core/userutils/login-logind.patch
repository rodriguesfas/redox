+/// Runs the shell of a login, telling the login manager about the session.
+///
+/// This is [`userutils::spawn_shell`] plus the session bookkeeping: the session
+/// leader is the shell, so that stopping the session stops what the user is
+/// running, and the login is reported as over once the shell is gone.
+fn spawn_shell_registered<T: Default>(user: &User<T>) -> io::Result<i32> {
+    let mut command = user.shell_cmd();
+
+    let mut child = command.spawn()?;
+
+    let terminal = session_terminal();
+    report_session(
+        "login",
+        &format!(
+            "login {} {} {} {}\n",
+            user.user,
+            user.uid,
+            terminal,
+            child.id()
+        ),
+    );
+
+    let code = match child.wait()?.code() {
+        Some(code) => code,
+        None => 1,
+    };
+
+    report_session("logout", &format!("logout {terminal}\n"));
+
+    Ok(code)
+}
+
+/// Tells the login manager about a session, best effort.
+///
+/// A boot without a login manager still has to be able to log in, so every
+/// failure here is ignored: a login that goes unrecorded is a far smaller
+/// problem than a login that cannot happen.
+fn report_session(action: &str, request: &str) {
+    let path = format!("/scheme/logind/{action}");
+    let Ok(mut file) = File::options().read(true).write(true).open(&path) else {
+        return;
+    };
+
+    let _ = file.write_all(request.as_bytes());
+    let _ = file.flush();
+}
+
+/// The terminal this login is on, as the session records name it.
+///
+/// `getty` says which terminal it is attached to in `TTY_NAME`; `TTY`, the pty
+/// it hands over, is only a fallback for a login started by hand.
+fn session_terminal() -> String {
+    std::env::var("TTY_NAME")
+        .or_else(|_| std::env::var("TTY"))
+        .unwrap_or_else(|_| "console".to_owned())
+}
